{
    "name": "invoicing/invoicing-system",
    "type": "project",
    "description": "Invoicing System with DDD, Hexagonal Architecture, CQRS, and Event-Driven Architecture",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.0",
        "nelmio/api-doc-bundle": "^4.20",
        "ramsey/uuid-doctrine": "^2.0",
        "symfony/amqp-messenger": "^7.3",
        "symfony/asset": "^7.3",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^7.3",
        "symfony/messenger": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/serializer": "^7.3",
        "symfony/twig-bundle": "^7.3",
        "symfony/uid": "^7.3",
        "symfony/validator": "^7.3",
        "symfony/yaml": "^7.3",
        "zircote/swagger-php": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/test-pack": "^1.1",
        "behat/behat": "^3.15",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/mink-extension": "^2.6",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-doctrine": "^1.3",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/phpunit-bridge": "^7.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": false,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "minimum-stability": "stable",
        "prefer-stable": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    }
}
